---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Sub/Track - Suscripciones</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,400;0,500&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
</head>
<body>

<!-- Splash Screen -->
<div class="splash" id="splashScreen">
  <div class="splash-content">
    <div class="splash-logo">sub<span>/</span>track</div>
    <div class="splash-spinner">
      <div class="splash-ring"></div>
    </div>
    <div class="splash-tagline">Cargando tus suscripciones…</div>
  </div>
</div>

<div class="container" id="appContainer" style="opacity: 0;">

  <header>
    <div class="logo">sub<span>/</span>track</div>
    <div class="last-update" id="lastUpdate"></div>
  </header>

  <!-- Hero Total -->
  <div class="hero-card">
    <div class="hero-label">Gasto Mensual</div>
    <div class="hero-total" id="totalMonthly">$0</div>
    <div class="hero-sub" id="totalAnnual">Proyección Anual: <strong>$0</strong></div>
    <div class="powered-badge">Powered by <strong>Google Antigravity</strong></div>
  </div>

  <!-- Próximo Cobro -->
  <div class="next-card" id="nextCard">
    <div class="next-icon-wrap" id="nextIcon"></div>
    <div class="next-info">
      <div class="next-info-label">Próximo Cobro</div>
      <div class="next-info-title" id="nextName">—</div>
    </div>
    <div class="next-days">
      <div class="next-days-val" id="nextDaysVal">—</div>
      <div class="next-days-sub" id="nextDate">—</div>
    </div>
  </div>

  <!-- Filtros -->
  <div class="cats-wrapper">
    <div class="cats-scroll" id="catPills"></div>
  </div>

  <!-- Activas -->
  <div class="sub-section">
    <div class="section-header">
      <div class="section-title">Tus Suscripciones</div>
      <div class="sub-count" id="subCount">0</div>
    </div>
    <ul class="sub-list" id="subList"></ul>
  </div>

  <!-- Distribución (Dona) -->
  <div class="chart-wrap">
    <h3>Distribución por Categoría</h3>
    <div style="height:200px;"><canvas id="chartDonut"></canvas></div>
  </div>

  <!-- Canceladas -->
  <div class="sub-section" id="cancelledCard" style="display:none;">
    <div class="cancelled-header" onclick="toggleCancelled()">
      <div class="section-title">Canceladas</div>
      <div class="sub-count" id="cancelledCount">0</div>
    </div>
    <div class="cancelled-body" id="cancelledBody">
      <ul class="sub-list" id="cancelledList"></ul>
    </div>
  </div>

  <div class="edit-hint">
    Busca <strong>const SUBSCRIPTIONS</strong> en el script para agregar o editar suscripciones.<br>
    Agrega <strong>cancelled: true</strong> para cancelar sin borrar.
  </div>

</div>

<!-- Modal de Detalle (Subscription Detail) -->
<div class="detail-overlay" id="detailOverlay" onclick="window.closeDetail(event)">
  <div class="detail-modal" id="detailModal">
    <button class="detail-close-btn" onclick="window.closeDetail(event)" aria-label="Cerrar modal">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    
    <div class="detail-header">
      <div class="detail-icon" id="detailIcon"></div>
      <h2 class="detail-title" id="detailName">—</h2>
      <span class="detail-category" id="detailCategory">—</span>
    </div>
    
    <div class="detail-body">
      <div class="detail-row">
        <span class="detail-label">Costo</span>
        <span class="detail-value highlight" id="detailPrice">—</span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Ciclo de Facturación</span>
        <span class="detail-value" id="detailCycle">—</span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Día de Cobro</span>
        <span class="detail-value" id="detailDay">—</span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Próximo Pago</span>
        <span class="detail-value" id="detailNextDate">—</span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Estado</span>
        <span class="detail-value" id="detailStatus">—</span>
      </div>
    </div>
    
    <div class="detail-footer">
      <button class="detail-action-btn" onclick="window.closeDetail(event)">Cerrar</button>
    </div>
  </div>
</div>

<script type="module">
/* ============================================================
   EDITA AQUÍ TUS SUSCRIPCIONES
   Campos:
     name       — Nombre del servicio
     price      — Precio en tu moneda local
     cycle      — "mensual" o "anual"
     category   — Categoría libre (para filtros y dona)
     billingDay — Día del mes en que te cobran (1-31)
     color      — Color del servicio en hex
     cancelled  — (opcional) true para marcar como cancelada
============================================================ */
const SUBSCRIPTIONS = [
  { name: "Netflix",         price: 299, cycle: "mensual", category: "Streaming", billingDay: 29, color: "#e50914" },
  { name: "YouTube Premium", price: 149, cycle: "mensual", category: "Streaming", billingDay: 30, color: "#ff0000" },
  { name: "Disney+",         price: 199, cycle: "mensual", category: "Streaming", billingDay: 15, color: "#1139a8", cancelled: true },
];

/* ============================================================
   LÓGICA
============================================================ */
const today = new Date();
today.setHours(0, 0, 0, 0);

function getNextBillingDate(billingDay) {
  const now = new Date();
  now.setHours(0, 0, 0, 0);

  function clampDay(day, year, month) {
    return Math.min(day, new Date(year, month + 1, 0).getDate());
  }

  let year  = now.getFullYear();
  let month = now.getMonth();
  let day   = clampDay(billingDay, year, month);
  let candidate = new Date(year, month, day);

  if (candidate < now) {
    month += 1;
    if (month > 11) { month = 0; year += 1; }
    day = clampDay(billingDay, year, month);
    candidate = new Date(year, month, day);
  }

  return candidate;
}

function daysBetween(d1, d2) {
  return Math.round((d2 - d1) / 86400000);
}

function monthlyEquivalent(sub) {
  return sub.cycle === "mensual" ? sub.price : sub.price / 12;
}

function annualEquivalent(sub) {
  return sub.cycle === "anual" ? sub.price : sub.price * 12;
}

function formatMXN(n) {
  return "$" + Math.round(n).toLocaleString("es-MX");
}

function daysColor(d) {
  if (d <= 5)  return "soon";
  if (d <= 15) return "mid";
  return "ok";
}

const LOGO_MAP = {
  "netflix":         "logo-netflix",
  "youtube premium": "logo-youtube",
  "spotify":         "logo-spotify",
  "disney+":         "logo-disney",
  "amazon prime":    "logo-prime",
  "hbo":             "logo-hbo",
  "apple tv+":       "logo-apple",
};

let activeCategory = "Todas";
let cancelledOpen  = false;
let chartDonut;

const activeSubs    = () => SUBSCRIPTIONS.filter(s => !s.cancelled);
const cancelledSubs = () => SUBSCRIPTIONS.filter(s =>  s.cancelled);

function getCategories() {
  return ["Todas", ...new Set(activeSubs().map(s => s.category))];
}

function filteredSubs() {
  const subs = activeSubs();
  return activeCategory === "Todas" ? subs : subs.filter(s => s.category === activeCategory);
}

/* ── Hero & Next Card ── */
function renderHeroAndNext() {
  const subs = activeSubs();
  const totalMonthly = subs.reduce((a, s) => a + monthlyEquivalent(s), 0);
  const totalAnnual  = subs.reduce((a, s) => a + annualEquivalent(s), 0);

  document.getElementById("totalMonthly").textContent = formatMXN(totalMonthly);
  document.getElementById("totalAnnual").innerHTML = `Proyección Anual: <strong>${formatMXN(totalAnnual)}</strong>`;

  const withDays = subs.map(s => ({ ...s, next: getNextBillingDate(s.billingDay) }));
  const upcoming = [...withDays].sort((a, b) => a.next - b.next)[0];

  if (upcoming) {
    const days = daysBetween(today, upcoming.next);
    const dc = daysColor(days);
    const logoClass = LOGO_MAP[upcoming.name.toLowerCase()] ?? "logo-default";

    const nextIconEl = document.getElementById("nextIcon");
    if (logoClass === 'logo-default') {
      nextIconEl.innerHTML = `<span style="font-weight:700; color:${upcoming.color};">${upcoming.name[0]}</span>`;
      nextIconEl.style.backgroundColor = upcoming.color + "18";
      nextIconEl.style.borderColor = upcoming.color + "33";
      nextIconEl.className = "next-icon-wrap";
    } else {
      nextIconEl.innerHTML = `<div class="logo-img ${logoClass}-img"></div>`;
      nextIconEl.style.backgroundColor = "";
      nextIconEl.style.borderColor = "";
      nextIconEl.className = `next-icon-wrap logo-brand ${logoClass}`;
    }
    
    document.getElementById("nextName").textContent = upcoming.name;
    
    const daysEl = document.getElementById("nextDaysVal");
    daysEl.textContent = `${days} d`;
    daysEl.className = `next-days-val ${dc}`;
    
    document.getElementById("nextDate").textContent = upcoming.next.toLocaleDateString("es-MX",{day:"2-digit",month:"short"});
    document.getElementById("nextCard").onclick = () => window.openDetail(upcoming.name);
  } else {
    document.getElementById("nextCard").style.display = "none";
  }
}

/* ── Category pills ── */
function renderCatPills() {
  document.getElementById("catPills").innerHTML = getCategories().map(c =>
    `<button class="cat-pill ${c === activeCategory ? 'active' : ''}" onclick="setCategory('${c}')">${c}</button>`
  ).join("");
}

window.setCategory = function(cat) {
  activeCategory = cat;
  renderCatPills();
  renderSubList();
  renderCharts();
};

/* ── Sub list ── */
function renderSubList() {
  const subs = filteredSubs();
  document.getElementById("subCount").textContent = subs.length;

  document.getElementById("subList").innerHTML = subs.map((s, i) => {
    const next = getNextBillingDate(s.billingDay);
    const days = daysBetween(today, next);
    const dc   = daysColor(days);
    const logoClass = LOGO_MAP[s.name.toLowerCase()] ?? "logo-default";

    let iconHTML = "";
    let iconClass = "sub-icon";
    let iconStyle = "";

    if (logoClass === 'logo-default') {
      iconHTML = `<span style="font-weight:700;">${s.name[0]}</span>`;
      iconStyle = `background-color:${s.color}18; color:${s.color};`;
      iconClass += " logo-default";
    } else {
      iconHTML = `<div class="logo-img ${logoClass}-img"></div>`;
      iconClass += ` logo-brand ${logoClass}`;
    }

    return `
    <li class="sub-item" style="animation-delay:${i * 0.05}s" onclick="window.openDetail('${s.name}')">
      <div class="${iconClass}" style="${iconStyle}">
        ${iconHTML}
      </div>
      <div>
        <div class="sub-name">${s.name}</div>
        <div class="sub-meta">
          <span class="next-days-val ${dc}" style="font-weight:600; font-size:0.8rem;">en ${days} d</span>
          <span class="dot">•</span> 
          ${next.toLocaleDateString("es-MX",{day:"2-digit",month:"short"})}
        </div>
      </div>
      <div class="sub-price-wrap">
        <div class="sub-price">${formatMXN(s.price)}</div>
        <div class="sub-cycle">${s.cycle}</div>
      </div>
    </li>`;
  }).join("");
}

/* ── Canceladas ── */
function renderCancelled() {
  const cancelled = cancelledSubs();
  const card  = document.getElementById("cancelledCard");
  const list  = document.getElementById("cancelledList");
  const count = document.getElementById("cancelledCount");

  if (cancelled.length === 0) { card.style.display = "none"; return; }

  card.style.display = "block";
  count.textContent  = cancelled.length;

  list.innerHTML = cancelled.map((s, i) => {
    const logoClass = LOGO_MAP[s.name.toLowerCase()] ?? "logo-default";
    
    let iconHTML = "";
    let iconClass = "sub-icon";
    let iconStyle = "";

    if (logoClass === 'logo-default') {
      iconHTML = `<span style="font-weight:700;">${s.name[0]}</span>`;
      iconStyle = `background-color:${s.color}18; color:${s.color}; opacity:0.6;`;
      iconClass += " logo-default";
    } else {
      iconHTML = `<div class="logo-img ${logoClass}-img"></div>`;
      iconClass += ` logo-brand ${logoClass}`;
      iconStyle = "opacity:0.6;";
    }

    return `
    <li class="sub-item" style="animation-delay:${i * 0.03}s;" onclick="window.openDetail('${s.name}')">
      <div class="${iconClass}" style="${iconStyle}">
        ${iconHTML}
      </div>
      <div>
        <div class="sub-name">${s.name}</div>
        <div class="sub-meta">Cancelada</div>
      </div>
      <div class="sub-price-wrap">
        <div class="sub-price" style="color:var(--muted);">${formatMXN(s.price)}</div>
        <div class="sub-cycle">${s.cycle}</div>
      </div>
    </li>`;
  }).join("");
}

window.toggleCancelled = function() {
  cancelledOpen = !cancelledOpen;
  document.getElementById("cancelledBody").style.display = cancelledOpen ? "block" : "none";
};

/* ── Charts ── */
function renderCharts() {
  const subs = filteredSubs();
  const catTotals = {};
  subs.forEach(s => { catTotals[s.category] = (catTotals[s.category] || 0) + monthlyEquivalent(s); });
  
  const catColors = ["#5f5cef", "#06b6d4", "#ef4444", "#10b981", "#f59e0b", "#a855f7", "#ec4899"];

  if (chartDonut) chartDonut.destroy();
  chartDonut = new Chart(document.getElementById("chartDonut"), {
    type: "doughnut",
    data: {
      labels: Object.keys(catTotals),
      datasets: [{ 
        data: Object.values(catTotals).map(v => Math.round(v)), 
        backgroundColor: catColors, 
        borderColor: "#101217", 
        borderWidth: 2, 
        hoverOffset: 4 
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false, cutout: "75%",
      plugins: {
        legend: { position: "right", labels: { color: "#8b95a5", font: { size: 11, family: "'Outfit'" }, boxWidth: 10, padding: 12 } },
        tooltip: { callbacks: { label: ctx => ctx.label + ": " + formatMXN(ctx.raw) + "/mes" } }
      }
    }
  });
}

function renderLastUpdate() {
  document.getElementById("lastUpdate").textContent =
    "Act. " + new Date().toLocaleDateString("es-MX", { day: "numeric", month: "short" });
}

window.openDetail = function(name) {
  const sub = SUBSCRIPTIONS.find(s => s.name.toLowerCase() === name.toLowerCase());
  if (!sub) return;

  const next = getNextBillingDate(sub.billingDay);
  const days = daysBetween(today, next);
  const dc   = daysColor(days);
  const logoClass = LOGO_MAP[sub.name.toLowerCase()] ?? "logo-default";

  // Cargar Icono
  const iconEl = document.getElementById("detailIcon");
  if (logoClass === 'logo-default') {
    iconEl.innerHTML = `<span style="font-weight:700; color:${sub.color};">${sub.name[0]}</span>`;
    iconEl.style.backgroundColor = sub.color + "18";
    iconEl.style.borderColor = sub.color + "33";
    iconEl.style.borderStyle = "solid";
    iconEl.className = "detail-icon logo-default";
  } else {
    iconEl.innerHTML = `<div class="logo-img ${logoClass}-img" style="width: 36px; height: 36px;"></div>`;
    iconEl.style.backgroundColor = "";
    iconEl.style.borderColor = "";
    iconEl.style.borderStyle = "";
    iconEl.className = `detail-icon logo-brand ${logoClass}`;
  }

  document.getElementById("detailName").textContent = sub.name;
  document.getElementById("detailCategory").textContent = sub.category;
  document.getElementById("detailPrice").textContent = formatMXN(sub.price);
  document.getElementById("detailCycle").textContent = sub.cycle.charAt(0).toUpperCase() + sub.cycle.slice(1);
  document.getElementById("detailDay").textContent = `Día ${sub.billingDay}`;
  
  if (sub.cancelled) {
    document.getElementById("detailNextDate").textContent = "N/A";
    document.getElementById("detailStatus").innerHTML = `<span style="color:var(--danger); font-weight:700;">Cancelada</span>`;
  } else {
    document.getElementById("detailNextDate").innerHTML = `${next.toLocaleDateString("es-MX", {day:"numeric", month:"long", year:"numeric"})} <span class="${dc}" style="font-size: 0.85rem; font-weight:700; margin-left: 6px;">(en ${days} días)</span>`;
    document.getElementById("detailStatus").innerHTML = `<span style="color:var(--success); font-weight:700;">Activa</span>`;
  }

  // Activar overlay y aplicar animaciones en body
  document.body.classList.add("modal-open");
  const overlay = document.getElementById("detailOverlay");
  overlay.classList.add("active");
};

window.closeDetail = function(event) {
  if (event) {
    const isOverlay = event.target.id === "detailOverlay";
    const isCloseBtn = event.target.closest(".detail-close-btn") || event.target.closest(".detail-action-btn");
    if (!isOverlay && !isCloseBtn) return;
  }
  
  const overlay = document.getElementById("detailOverlay");
  overlay.classList.remove("active");
  document.body.classList.remove("modal-open");
};

function dismissSplash() {
  const splash = document.getElementById('splashScreen');
  const app = document.getElementById('appContainer');
  
  // Fade out splash
  splash.classList.add('splash-exit');
  
  // Fade in app container
  setTimeout(() => {
    app.style.transition = 'opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
    app.style.opacity = '1';
  }, 300);
  
  // Remove splash from DOM after animation
  setTimeout(() => {
    splash.style.display = 'none';
  }, 800);

  // Trigger one-time shimmer hint on first sub-item after app is visible
  setTimeout(() => {
    triggerHintShimmer();
  }, 1200);
}

function triggerHintShimmer() {
  // Check if this hint has already been shown in this session
  if (sessionStorage.getItem('subtrack_hint_shown')) return;
  sessionStorage.setItem('subtrack_hint_shown', 'true');

  const firstItem = document.querySelector('#subList .sub-item');
  if (!firstItem) return;

  // Add the shimmer hint class
  firstItem.classList.add('hint-shimmer');

  // Add a small floating tooltip
  const tooltip = document.createElement('div');
  tooltip.className = 'hint-tooltip';
  tooltip.innerHTML = `
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 15l-2 5L9 9l11 4-5 2z"></path><path d="M14 14l5 5"></path></svg>
    Toca para ver detalles
  `;
  firstItem.style.position = 'relative';
  firstItem.appendChild(tooltip);

  // Remove hint after animation completes
  setTimeout(() => {
    firstItem.classList.remove('hint-shimmer');
    if (tooltip.parentNode) tooltip.remove();
  }, 3500);
}

function init() {
  renderHeroAndNext();
  renderCatPills();
  renderSubList();
  renderCancelled();
  renderCharts();
  renderLastUpdate();

  // Dismiss splash after a minimum display time for polish
  setTimeout(dismissSplash, 1200);
}

init();
</script>
</body>
</html>